{
  "extends": "./tsconfig.base.json",
  "exclude": ["**/lib/**"],
  "compilerOptions": {
    "types": ["node", "jest"],
    "rootDir": ".",
    "paths": {
      "@sociably/auth": ["./packages/auth/src/index.js"],
      "@sociably/auth/*": ["./packages/auth/src/*/index.js"],
      "@sociably/core": ["./packages/core/src/index.js"],
      "@sociably/core/jsx-runtime": ["./packages/core/src/jsx-runtime.ts"],
      "@sociably/core/jsx-dev-runtime": ["./packages/core/src/jsx-dev-runtime.ts"],
      "@sociably/core/*": [
        "./packages/core/src/*/index.js",
        "./packages/core/src/*"
      ],
      "@sociably/dev-tools": ["./packages/dev-tools/src/index.js"],
      "@sociably/dev-tools/*": ["./packages/dev-tools/src/*/index.js"],
      "@sociably/facebook-platform": [
        "./packages/facebook-platform/src/index.js"
      ],
      "@sociably/facebook-platform/*": [
        "./packages/facebook-platform/src/*/index.js"
      ],
      "@sociably/http": ["./packages/http/src/index.js"],
      "@sociably/http/*": ["./packages/http/src/*/index.js"],
      "@sociably/instagram-platform": [
        "./packages/instagram-platform/src/index.js"
      ],
      "@sociably/instagram-platform/*": [
        "./packages/instagram-platform/src/*/index.js"
      ],
      "@sociably/line-platform": ["./packages/line-platform/src/index.js"],
      "@sociably/line-platform/*": ["./packages/line-platform/src/*/index.js"],
      "@sociably/meta-api": ["./packages/meta-api/src/index.js"],
      "@sociably/meta-messenger-platform-base": [
        "./packages/meta-messenger-platform-base/src/index.js"
      ],
      "@sociably/meta-messenger-platform-base/*": [
        "./packages/meta-messenger-platform-base/src/*/index.js"
      ],
      "@sociably/next": ["./packages/next/src/index.js"],
      "@sociably/telegram-platform": [
        "./packages/telegram-platform/src/index.js"
      ],
      "@sociably/telegram-platform/*": [
        "./packages/telegram-platform/src/*/index.js"
      ],
      "@sociably/twitter-platform": [
        "./packages/twitter-platform/src/index.js"
      ],
      "@sociably/twitter-platform/*": [
        "./packages/twitter-platform/src/*/index.js"
      ],
      "@sociably/websocket": ["./packages/websocket/src/index.js"],
      "@sociably/websocket/*": ["./packages/websocket/src/*/index.js"],
      "@sociably/webview": ["./packages/webview/src/index.js"],
      "@sociably/webview/*": ["./packages/webview/src/*/index.js"],
      "@sociably/whatsapp-platform": [
        "./packages/whatsapp-platform/src/index.js"
      ],
      "@sociably/whatsapp-platform/*": [
        "./packages/whatsapp-platform/src/*/index.js"
      ]
    }
  }
}
